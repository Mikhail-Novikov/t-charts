  // Метод для вычисления процентного изменения
  function calculatePercent(current, previous) {
    var curr = parseInt(current.toString().replace(/\s/g, ''));
    var prev = parseInt(previous.toString().replace(/\s/g, ''));

    if (prev === 0) return '0%';

    var change = ((curr - prev) / prev * 100).toFixed(0);
    return (change > 0 ? '+' : '') + change + '%';
  }

