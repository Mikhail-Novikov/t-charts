  // Рекурсивное вычисление процентного изменения для каждой строки (включая вложенные children)
  function computePercents(rows) {
    rows.forEach(function(row) {
      row.percent = calculatePercent(row.currentDay, row.yesterday);
      if (row.children && row.children.length) {
        computePercents(row.children);
      }
    });
  }

  computePercents(tableData);